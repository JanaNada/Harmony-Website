# Copy this file to .env and fill in your own values.
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)

PORT=4000
NODE_ENV=development

# Your local MySQL. DB_PASSWORD is whatever you set when installing MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=harmony_db

# Any long random string. Sessions are signed with this, so pick your own —
# do not copy one from another machine or from a chat message.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d
